generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  image                 String?
  password              String
  role                  Role           @default(USER)
  posts                 Post[]
  announcements         Announcement[]
  createdAt             DateTime       @default(now())
  comments              Comment[]
  likesC                LikeC[]
  likesP                LikeP[]
  receivedNotifications Notification[] @relation("Recipient")
  issuedNotifications   Notification[] @relation("Issuer")
}

enum Role {
  USER
  ADMIN
}

model Announcement {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title     String
  media     Media[]
  createdAt DateTime @default(now())
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String   @db.Uuid
}

model Post {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String
  subject       Subject
  content       String?
  category      Categorie
  createdAt     DateTime       @default(now())
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId      String         @db.Uuid
  attachment    Media[] // Removed the `@relation` field-specific arguments
  correction    Boolean        @default(false)
  comments      Comment[]
  notifications Notification[]
  likes         LikeP[]
}

model Comment {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  message       String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String         @db.Uuid
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId        String         @db.Uuid
  parent        Comment?       @relation("ParentChild", fields: [parentId], references: [id], onDelete: Cascade)
  children      Comment[]      @relation("ParentChild")
  parentId      String?        @db.Uuid
  likes         LikeC[]
  notifications Notification[]
}

model LikeC {
  userId    String  @db.Uuid
  //when we delete a user, the likes are deleted
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String  @db.Uuid
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model LikeP {
  userId String @db.Uuid
  //when we delete a user, the likes are deleted
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId String @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Media {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  postId         String?       @unique @db.Uuid
  post           Post?         @relation(fields: [postId], references: [id], onDelete: SetNull)
  type           MediaType
  url            String
  createdAt      DateTime      @default(now())
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: SetNull)
  announcementId String?       @db.Uuid
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String           @db.Uuid
  recipient   User             @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  issuerId    String           @db.Uuid
  issuer      User             @relation("Issuer", fields: [issuerId], references: [id], onDelete: Cascade)
  postId      String?          @db.Uuid
  post        Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId   String?          @db.Uuid
  comment     Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  type        NotificationType
  read        Boolean          @default(false)

  createdAt DateTime @default(now())
}

enum MediaType {
  IMAGE
  PDF
}

enum Subject {
  ANGLAIS
  COMPTABILITE_GENERALE
  BASES_DE_DONNEES
  ELECTRONIQUE_ANALOGIQUE_2
  TEC_2
  ANALYSE_4
  PROGRAMMATION_WEB
  INFORMATIQUE_INDUSTRIELLE
  STRUCTURE_DONNEES_2
  STATISTIQUE
  SYSTEMES_EXPLOITATION_2
}

enum Categorie {
  COURS
  EXAMENS
  CONTROLES
  TDS
  TPS
}

enum NotificationType {
  LIKE
  COMMENT
  REPLY
}
